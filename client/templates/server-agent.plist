<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>{{ label }}</string>
	<key>LimitLoadToSessionType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{ program.display() }}</string>
		<string>--server</string>
		<string>--idle-exit-secs</string>
		<string>{{ idle_exit.as_secs() }}</string>
		<string>--build</string>
		<string>{{ build }}</string>
		{%- if let Some(cache) = model_cache %}
		<string>--model-cache</string>
		<string>{{ cache.display() }}</string>
		{%- endif %}
		{%- if let Some(token) = token_file %}
		<string>--token-file</string>
		<string>{{ token.display() }}</string>
		{%- endif %}
	</array>
	<key>Sockets</key>
	<dict>
		<key>Unix</key>
		<dict>
			<key>SockPathName</key>
			<string>{{ socket.display() }}</string>
			<key>SockPathMode</key>
			<integer>384</integer>
		</dict>
		<key>Tcp</key>
		<dict>
			<key>SockNodeName</key>
			<string>{{ bind }}</string>
			<key>SockServiceName</key>
			<string>{{ port }}</string>
			<key>SockFamily</key>
			<string>{% if bind.is_ipv4() %}IPv4{% else %}IPv6{% endif %}</string>
		</dict>
	</dict>
	<key>StandardErrorPath</key>
	<string>{{ stderr.display() }}</string>
</dict>
</plist>
